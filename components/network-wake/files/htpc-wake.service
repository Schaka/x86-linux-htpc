[Unit]
Description=Wake the TV over the network at login (x86-linux-htpc)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/x86-linux-htpc/wake-devices

[Install]
WantedBy=graphical-session.target
