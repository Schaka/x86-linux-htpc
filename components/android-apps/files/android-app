#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
#
# Starts an Android app in the full-screen interface of Waydroid.
#
#   android-app PACKAGE
#
# The Android TV image shows apps only inside its full-screen interface,
# not as single windows. The user service waydroid-session.service of the
# component waydroid runs the Android session. The script waits until
# Android finished its start, starts the app, and then shows the interface
# with the app in front.
set -euo pipefail

package="${1:?Usage: android-app PACKAGE}"

android_ready() {
	waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING' &&
		[[ "$(waydroid prop get sys.boot_completed 2>/dev/null | tail -n 1)" == 1 ]]
}

systemctl --user start waydroid-session.service
for _ in $(seq 90); do
	android_ready && break
	sleep 1
done
android_ready || {
	printf 'ERROR: Android did not start within 90 seconds.\n' >&2
	exit 1
}

# KWin keeps a minimized window minimized when Waydroid shows its interface
# again. The home action of the control API minimizes the window. So the
# launcher restores and activates it through a KWin script.
show_waydroid_window() {
	local script name=htpc-show-waydroid id
	script="${XDG_RUNTIME_DIR:-/tmp}/${name}.js"
	cat >"${script}" <<'SCRIPT'
for (const w of workspace.windowList()) {
    if (w.normalWindow && /waydroid/i.test(w.resourceClass + " " + w.desktopFileName)) {
        w.minimized = false;
        workspace.activeWindow = w;
    }
}
SCRIPT
	busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting unloadScript s "${name}" >/dev/null 2>&1 || true
	id="$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting loadScript ss "${script}" "${name}" 2>/dev/null | awk '{print $2}')"
	if [[ "${id}" =~ ^[0-9]+$ ]]; then
		busctl --user call org.kde.KWin "/Scripting/Script${id}" org.kde.kwin.Script run >/dev/null 2>&1 || true
		sleep 0.5
	fi
	busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting unloadScript s "${name}" >/dev/null 2>&1 || true
	rm -f "${script}"
}

waydroid app launch "${package}"
# With a running session, show-full-ui only shows the interface and ends.
# A show-full-ui at the same time as the start of the app shows no window.
waydroid show-full-ui
show_waydroid_window
