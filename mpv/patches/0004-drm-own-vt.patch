+// The kernel shows one VT at a time. logind switches it for the user of a
+// local session, so a player without root can take the screen from the
+// compositor on another VT. The switch runs here and not in a script,
+// because the player core does not answer scripts while the output starts.
+static void switch_vt(struct vo_drm_state *drm)
+{
+    int vt = drm->opts->vt;
+    if (vt <= 0)
+        return;
+#if HAVE_DRM_LOGIND
+    sd_bus *bus = NULL;
+    sd_bus_error error = SD_BUS_ERROR_NULL;
+    int r = sd_bus_open_system(&bus);
+    if (r >= 0) {
+        r = sd_bus_call_method(bus, "org.freedesktop.login1",
+                               "/org/freedesktop/login1/seat/seat0",
+                               "org.freedesktop.login1.Seat", "SwitchTo",
+                               &error, NULL, "u", (uint32_t)vt);
+    }
+    if (r < 0) {
+        MP_ERR(drm, "Cannot switch to VT %d: %s\n", vt,
+               error.message ? error.message : mp_strerror(-r));
+    }
+    sd_bus_error_free(&error);
+    sd_bus_unref(bus);
+#else
+    MP_ERR(drm, "--drm-vt needs an mpv built with libsystemd.\n");
+#endif
+}
+
+// A program without root gets the DRM master only when it opens the card
+// while no other program holds the master. A compositor on another VT holds
+// it until logind drops it at the switch to the VT of the player. The switch
+// can still run when the output starts, so the output opens the card again
+// until it gets the master.
+static bool wait_for_master(struct vo_drm_state *drm)
+{
+    int64_t deadline = mp_time_ns_add(mp_time_ns(), drm->opts->master_wait);
+    while (drm->opts->master_wait > 0 && !drmIsMaster(drm->fd)) {
+        if (mp_time_ns() > deadline) {
+            MP_ERR(drm, "No DRM master after %g seconds.\n", drm->opts->master_wait);
+            return false;
+        }
+        close(drm->fd);
+        mp_sleep_ns(MP_TIME_MS_TO_NS(20));
+        drm->fd = open_card_path(drm->card_path);
+        if (drm->fd < 0) {
+            MP_ERR(drm, "Cannot open card \"%d\": %s.\n", drm->card_no,
+                   mp_strerror(errno));
+            return false;
+        }
+    }
+    return true;
+}
+
