diff --git a/video/out/gpu_next/cb1.c b/video/out/gpu_next/cb1.c
new file mode 100644
index 0000000..dcfc2dd
--- /dev/null
+++ b/video/out/gpu_next/cb1.c
@@ -0,0 +1,287 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <math.h>
+
+#include <libavutil/buffer.h>
+#include <libavutil/frame.h>
+#include <libplacebo/opengl.h>
+
+#include <dvbridge_dmabuf.h>
+#include <dvbridge_gl_frame.h>
+#include <dvbridge_placebo.h>
+#include <dvbridge_render.h>
+
+#include "cb1.h"
+#include "common/msg.h"
+#include "mpv_talloc.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+// The HDR10 output is 10 bits for each color in full range, as the
+// XRGB2101010 framebuffer carries it.
+#define HDR10_BITS 10
+
+struct mp_cb1 {
+    struct mp_log *log;
+    pl_gpu gpu;
+    struct dvbridge_renderer *renderer;
+    enum mp_cb1_mode mode;
+    // The HDR10 target of the current video, from its first frame
+    struct dvbridge_hdr10_session session;
+    bool have_session;
+    // A drawn picture waits for its presentation.
+    bool prepared;
+    // Log each reason for a fallback once, not for each frame.
+    const char *last_failure;
+    // The kind of the enhancement layer of the last frame, for the log
+    const char *last_layer;
+};
+
+struct mp_cb1 *mp_cb1_create(struct mp_log *log, pl_gpu gpu, enum mp_cb1_mode mode)
+{
+    if (!pl_opengl_get(gpu)) {
+        mp_err(log, "CB1 needs --gpu-api=opengl.\n");
+        return NULL;
+    }
+    struct dvbridge_renderer *renderer = dvbridge_renderer_create(gpu);
+    if (!renderer) {
+        mp_err(log, "CB1 failed to start.\n");
+        return NULL;
+    }
+    struct mp_cb1 *cb1 = talloc_zero(NULL, struct mp_cb1);
+    *cb1 = (struct mp_cb1) {
+        .log = log,
+        .gpu = gpu,
+        .renderer = renderer,
+        .mode = mode,
+    };
+    mp_info(log, "CB1 Dolby Vision engine started, output %s.\n",
+            mode == MP_CB1_HDR10 ? "HDR10" : "Dolby Vision");
+    return cb1;
+}
+
+void mp_cb1_destroy(struct mp_cb1 **cb1p)
+{
+    struct mp_cb1 *cb1 = *cb1p;
+    if (!cb1)
+        return;
+    dvbridge_renderer_destroy(cb1->renderer);
+    talloc_free(cb1);
+    *cb1p = NULL;
+}
+
+void mp_cb1_reset(struct mp_cb1 *cb1)
+{
+    if (!cb1)
+        return;
+    dvbridge_renderer_reset(cb1->renderer);
+    cb1->have_session = false;
+    cb1->prepared = false;
+    cb1->last_layer = NULL;
+}
+
+static bool fail(struct mp_cb1 *cb1, const char *reason)
+{
+    if (cb1->last_failure != reason)
+        MP_WARN(cb1, "CB1 does not draw this frame: %s\n", reason);
+    cb1->last_failure = reason;
+    return false;
+}
+
+// CB1 imports the GL textures of the decoder itself, with its own color
+// representation of each layout, as in the Kodi integration.
+static bool import_frame(struct mp_cb1 *cb1, const struct pl_frame *image,
+                         const struct mp_image *mpi,
+                         struct dvbridge_gl_frame *out)
+{
+    enum dvbridge_gl_layout layout;
+    switch (mpi->params.hw_subfmt) {
+    case IMGFMT_NV12: layout = DVBRIDGE_NV12; break;
+    case IMGFMT_P010: layout = DVBRIDGE_P010; break;
+    default: return false;
+    }
+    if (image->num_planes != 2)
+        return false;
+
+    struct dvbridge_gl_plane planes[3] = {0};
+    for (int i = 0; i < image->num_planes; i++) {
+        pl_tex tex = image->planes[i].texture;
+        planes[i] = (struct dvbridge_gl_plane) {
+            .texture = pl_opengl_unwrap(cb1->gpu, tex, NULL, NULL, NULL),
+            .width = tex->params.w,
+            .height = tex->params.h,
+        };
+        if (!planes[i].texture)
+            return false;
+    }
+    if (!dvbridge_gl_frame_import(out, cb1->gpu, layout, mpi->params.w,
+                                  mpi->params.h, planes))
+        return false;
+    dvbridge_gl_frame_set_chroma(out, mpi->params.chroma_location);
+    return true;
+}
+
+// The EL picture of a profile 7 stream is a VA-API surface of the EL
+// decoder of video/decode/cb1_fel.c. CB1 imports it through DMA-BUF.
+static bool import_enhancement(struct mp_cb1 *cb1, const AVFrame *el,
+                               struct dvbridge_dmabuf *dmabuf,
+                               struct dvbridge_gl_frame *out)
+{
+    if (!dvbridge_dmabuf_import(dmabuf, el))
+        return false;
+    if (!dvbridge_gl_frame_import(out, cb1->gpu, dmabuf->layout, el->width,
+                                  el->height, dmabuf->planes))
+    {
+        dvbridge_dmabuf_release(dmabuf);
+        return false;
+    }
+    // Profile 7 streams without a chroma location use top left, as Kodi
+    // does.
+    dvbridge_gl_frame_set_chroma(out, el->chroma_location == AVCHROMA_LOC_UNSPECIFIED ?
+                                      PL_CHROMA_TOP_LEFT :
+                                      dvbridge_map_chroma(el->chroma_location));
+    return true;
+}
+
+// The EL of profile 7 is either a full enhancement layer (FEL) with
+// picture data, or a minimal one (MEL) without. Only the RPU tells.
+static void log_layer(struct mp_cb1 *cb1, bool paired, const void *metadata,
+                      size_t bytes)
+{
+    const char *layer = "none";
+    struct dvbridge_color color;
+    if (paired) {
+        layer = dvbridge_map_color(&color, metadata, bytes, true) &&
+                color.dovi.nlq_active ? "FEL" : "MEL";
+    }
+    if (cb1->last_layer != layer)
+        MP_INFO(cb1, "CB1 enhancement layer: %s\n", layer);
+    cb1->last_layer = layer;
+}
+
+bool mp_cb1_render(struct mp_cb1 *cb1, const struct pl_frame *image,
+                   struct mp_image *mpi, struct mp_rect dst, pl_tex target,
+                   bool flipped, struct pl_color_space *color)
+{
+    if (!mpi->dovi_av)
+        return fail(cb1, "the frame has no Dolby Vision metadata");
+    if (!mpi->hwctx)
+        return fail(cb1, "the frame is not hardware decoded");
+    if (!isfinite(mpi->pts))
+        return fail(cb1, "the frame has no timestamp");
+
+    const void *metadata = mpi->dovi_av->data;
+    size_t bytes = mpi->dovi_av->size;
+    bool hdr10 = cb1->mode == MP_CB1_HDR10;
+    if (hdr10 && !cb1->have_session) {
+        if (!dvbridge_hdr10_session_init(&cb1->session, metadata, bytes))
+            return fail(cb1, "the Dolby Vision metadata gives no HDR10 target");
+        cb1->have_session = true;
+    }
+
+    // Hardware frames get their textures only between acquire and release,
+    // as libplacebo does it for its own rendering.
+    struct pl_frame mapped = *image;
+    if (mapped.acquire && !mapped.acquire(cb1->gpu, &mapped))
+        return fail(cb1, "the hardware frame cannot be mapped");
+
+    struct dvbridge_gl_frame frame = {0};
+    if (!import_frame(cb1, &mapped, mpi, &frame)) {
+        if (mapped.release)
+            mapped.release(cb1->gpu, &mapped);
+        return fail(cb1, "CB1 cannot import this frame format");
+    }
+
+    // CB1 needs the same time for both layers. The EL decoder paired them
+    // by this time.
+    struct dvbridge_dmabuf el_dmabuf = {0};
+    struct dvbridge_gl_frame el = {0};
+    double el_pts = NAN;
+    if (mpi->dovi_el) {
+        if (!import_enhancement(cb1, (const AVFrame *)mpi->dovi_el->data,
+                                &el_dmabuf, &el))
+        {
+            dvbridge_gl_frame_release(&frame);
+            if (mapped.release)
+                mapped.release(cb1->gpu, &mapped);
+            return fail(cb1, "CB1 cannot import the enhancement layer picture");
+        }
+        frame.frame.enhancement_layer = &el.frame;
+        el_pts = mpi->pts;
+    }
+
+    struct dvbridge_geometry geometry = {
+        .source_width = mpi->params.w,
+        .source_height = mpi->params.h,
+        .x = dst.x0,
+        .y = dst.y0,
+        .width = mp_rect_w(dst),
+        .height = mp_rect_h(dst),
+        .target_width = target->params.w,
+        .target_height = target->params.h,
+    };
+    bool ok;
+    if (!hdr10) {
+        ok = dvbridge_render_packed(cb1->renderer, &frame.frame, metadata, bytes,
+                                    mpi->pts, el_pts, geometry, target, flipped);
+    } else if (!geometry.x && !geometry.y && geometry.width == geometry.target_width &&
+               geometry.height == geometry.target_height) {
+        // A video that fills the screen goes directly into the target.
+        ok = dvbridge_render_hdr10_direct(cb1->renderer, &cb1->session, &frame.frame,
+                                          metadata, bytes, mpi->pts, el_pts, geometry,
+                                          target, flipped, false, HDR10_BITS);
+    } else {
+        ok = dvbridge_render_hdr10_rgb(cb1->renderer, &cb1->session, &frame.frame,
+                                       metadata, bytes, mpi->pts, el_pts, geometry) &&
+             dvbridge_render_hdr10(cb1->renderer, target, flipped, false, HDR10_BITS);
+    }
+    if (mpi->dovi_el) {
+        dvbridge_gl_frame_release(&el);
+        dvbridge_dmabuf_release(&el_dmabuf);
+    }
+    dvbridge_gl_frame_release(&frame);
+    if (mapped.release)
+        mapped.release(cb1->gpu, &mapped);
+    if (!ok)
+        return fail(cb1, "CB1 rendering failed");
+    log_layer(cb1, mpi->dovi_el, metadata, bytes);
+    if (cb1->last_failure)
+        MP_INFO(cb1, "CB1 draws the frames again.\n");
+    cb1->last_failure = NULL;
+    cb1->prepared = true;
+    if (hdr10) {
+        *color = cb1->session.target;
+        // Dolby Vision metadata has no mastering primaries. Without those of
+        // the stream, the output names the BT.2020 container.
+        color->hdr.prim = pl_primaries_valid(&mpi->params.color.hdr.prim) ?
+                          mpi->params.color.hdr.prim :
+                          *pl_raw_primaries_get(PL_COLOR_PRIM_BT_2020);
+    }
+    return true;
+}
+
+void mp_cb1_presented(struct mp_cb1 *cb1, bool success)
+{
+    if (!cb1 || !cb1->prepared)
+        return;
+    cb1->prepared = false;
+    if (!success || !dvbridge_render_commit(cb1->renderer)) {
+        // A lost picture must not become the reference for the next one.
+        dvbridge_renderer_reset(cb1->renderer);
+    }
+}
