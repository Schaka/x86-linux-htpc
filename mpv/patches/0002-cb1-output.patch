+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <libplacebo/renderer.h>
+
+#include "common/common.h"
+
+struct mp_cb1;
+struct mp_log;
+struct mp_image;
+
+// The output modes of CB1. The values match --cb1 and --drm-dvbridge.
+enum mp_cb1_mode {
+    MP_CB1_OFF,
+    // TV-led Dolby Vision: the metadata goes in the pixels of the picture.
+    MP_CB1_DOLBY_VISION,
+    // CB1 maps the Dolby Vision picture to HDR10 with static metadata.
+    MP_CB1_HDR10,
+};
+
+// The adapter between vo_gpu_next and the CB1 Dolby Vision engine.
+struct mp_cb1 *mp_cb1_create(struct mp_log *log, pl_gpu gpu, enum mp_cb1_mode mode);
+void mp_cb1_destroy(struct mp_cb1 **cb1);
+
+// Call for each new video. The HDR10 mode takes its static metadata from
+// the first frame of a video.
+void mp_cb1_reset(struct mp_cb1 *cb1);
+
+// Draws the picture of image into target. image must be a hardware
+// decoded frame with its Dolby Vision metadata. dst is the place of the
+// video in target. In the HDR10 mode, color receives the color space of
+// the picture, for the HDR metadata of the output. Returns false if CB1
+// cannot draw this frame. Then the caller draws it the normal way.
+bool mp_cb1_render(struct mp_cb1 *cb1, const struct pl_frame *image,
+                   struct mp_image *mpi, struct mp_rect dst, pl_tex target,
+                   bool flipped, struct pl_color_space *color);
+
+// Call after the swap of a frame that mp_cb1_render() drew. CB1 commits
+// its metadata state only for pictures that reached the screen.
+void mp_cb1_presented(struct mp_cb1 *cb1, bool success);
