diff --git a/video/decode/cb1_fel.c b/video/decode/cb1_fel.c
new file mode 100644
index 0000000..a90a751
--- /dev/null
+++ b/video/decode/cb1_fel.c
@@ -0,0 +1,232 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <libavutil/buffer.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+
+#include <dvbridge_fel.h>
+
+#include "cb1_fel.h"
+#include "common/msg.h"
+#include "demux/stheader.h"
+#include "mpv_talloc.h"
+#include "video/mp_image.h"
+
+struct pending {
+    struct mp_image *mpi;
+    int64_t pts;
+    // The picture carries its own intact RPU.
+    bool own_rpu;
+};
+
+struct mp_cb1_fel {
+    struct mp_log *log;
+    struct dvbridge_fel *fel;
+    struct pending *queue;
+    int num_queue;
+    // The EL failed. The base layer plays alone until the next reset.
+    bool failed;
+    bool paired;
+    bool metadata_only;
+};
+
+static void fail(struct mp_cb1_fel *fel, const char *reason)
+{
+    if (!fel->failed) {
+        MP_ERR(fel, "Dolby Vision FEL: %s. The video plays without its "
+               "enhancement layer.\n", reason);
+    }
+    fel->failed = true;
+}
+
+static void free_frame(void *opaque, uint8_t *data)
+{
+    AVFrame *frame = (AVFrame *)data;
+    av_frame_free(&frame);
+}
+
+struct mp_cb1_fel *mp_cb1_fel_create(struct mp_log *log,
+                                     const struct mp_codec_params *codec,
+                                     AVCodecContext *avctx)
+{
+    const AVCodecParameters *par = codec->lav_codecpar;
+    if (!codec->dovi || codec->dv_profile != 7 || !par)
+        return NULL;
+    const AVPacketSideData *sd = av_packet_side_data_get(par->coded_side_data,
+                                                         par->nb_coded_side_data,
+                                                         AV_PKT_DATA_DOVI_CONF);
+    if (!sd || sd->size < sizeof(AVDOVIDecoderConfigurationRecord) ||
+        !((const AVDOVIDecoderConfigurationRecord *)sd->data)->el_present_flag)
+        return NULL;
+    // Without its own configuration, the EL decoder starts with that of the
+    // base layer, and needs the parameter sets inside the EL units.
+    if (!av_packet_side_data_get(par->coded_side_data, par->nb_coded_side_data,
+                                 AV_PKT_DATA_HEVC_CONF))
+        mp_verbose(log, "The stream has no configuration for its enhancement layer.\n");
+
+    struct dvbridge_fel *dvfel = dvbridge_fel_create(par, avctx->pkt_timebase);
+    if (!dvfel) {
+        mp_err(log, "Dolby Vision FEL: the enhancement layer decoder failed to start.\n");
+        return NULL;
+    }
+    struct mp_cb1_fel *fel = talloc_zero(NULL, struct mp_cb1_fel);
+    fel->log = log;
+    fel->fel = dvfel;
+    mp_verbose(log, "Dolby Vision profile 7: decoding the enhancement layer.\n");
+    return fel;
+}
+
+static void clear_queue(struct mp_cb1_fel *fel)
+{
+    for (int n = 0; n < fel->num_queue; n++)
+        talloc_free(fel->queue[n].mpi);
+    fel->num_queue = 0;
+}
+
+void mp_cb1_fel_destroy(struct mp_cb1_fel **felp)
+{
+    struct mp_cb1_fel *fel = *felp;
+    if (!fel)
+        return;
+    clear_queue(fel);
+    dvbridge_fel_destroy(fel->fel);
+    talloc_free(fel);
+    *felp = NULL;
+}
+
+void mp_cb1_fel_reset(struct mp_cb1_fel *fel)
+{
+    if (!fel)
+        return;
+    clear_queue(fel);
+    dvbridge_fel_reset(fel->fel);
+    fel->failed = false;
+}
+
+// The EL decoder uses the VA-API device of the base layer decoder. That
+// decoder gets its device only with its first hardware frames.
+static void bind_device(struct mp_cb1_fel *fel, AVCodecContext *avctx)
+{
+    if (fel->failed || !avctx->hw_frames_ctx)
+        return;
+    AVHWFramesContext *frames = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+    if (!dvbridge_fel_device(fel->fel, frames->device_ref))
+        fail(fel, "the enhancement layer needs VA-API");
+}
+
+void mp_cb1_fel_send(struct mp_cb1_fel *fel, AVCodecContext *avctx,
+                     const AVPacket *pkt)
+{
+    if (!fel)
+        return;
+    bind_device(fel, avctx);
+    if (fel->failed)
+        return;
+    if (pkt) {
+        if (!dvbridge_fel_submit(fel->fel, pkt))
+            fail(fel, "the enhancement layer cannot be decoded");
+        return;
+    }
+    const char *reason = NULL;
+    if (!dvbridge_fel_drain(fel->fel, &reason))
+        fail(fel, reason ? reason : "the enhancement layer cannot be decoded");
+}
+
+// FFmpeg keeps the parsed metadata of an earlier picture on a picture
+// without an RPU. Only a picture with its own intact RPU can prove that it
+// needs no EL picture.
+static bool has_own_rpu(const AVFrame *frame)
+{
+    if (frame->decode_error_flags ||
+        (frame->flags & (AV_FRAME_FLAG_CORRUPT | AV_FRAME_FLAG_DISCARD)))
+        return false;
+    const AVFrameSideData *rpu = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+    // The RPU starts with the prefix 25, then rpu_type 2 in the upper 6 bits.
+    return rpu && rpu->size >= 5 && rpu->data[0] == 25 && (rpu->data[1] >> 2) == 2;
+}
+
+void mp_cb1_fel_push(struct mp_cb1_fel *fel, AVCodecContext *avctx,
+                     struct mp_image *mpi, const AVFrame *frame)
+{
+    int64_t pts = frame->pts;
+    bind_device(fel, avctx);
+    if (pts == AV_NOPTS_VALUE)
+        fail(fel, "a base layer picture has no timestamp");
+    if (fel->num_queue >= MP_CB1_FEL_PENDING)
+        fail(fel, "too many pictures wait for their enhancement layer");
+    MP_TARRAY_APPEND(fel, fel->queue, fel->num_queue,
+                     (struct pending){.mpi = mpi, .pts = pts,
+                                      .own_rpu = has_own_rpu(frame)});
+}
+
+// A profile 7 MEL stream can come without EL pictures. CB1 then reads the
+// RPU of the picture, and if it needs no residual, the picture plays with
+// its metadata only (result 3).
+static int take(struct mp_cb1_fel *fel, const struct pending *p, AVFrame **el)
+{
+    if (fel->failed)
+        return -1;
+    if (p->own_rpu && p->mpi->dovi_av) {
+        return dvbridge_fel_take_mel(fel->fel, p->pts, el, p->mpi->dovi_av->data,
+                                     p->mpi->dovi_av->size);
+    }
+    return dvbridge_fel_take(fel->fel, p->pts, el);
+}
+
+struct mp_image *mp_cb1_fel_pop(struct mp_cb1_fel *fel, bool eof)
+{
+    while (fel->num_queue) {
+        struct pending p = fel->queue[0];
+        AVFrame *el = NULL;
+        int res = take(fel, &p, &el);
+        if (res == 0 && !eof)
+            return NULL;
+        MP_TARRAY_REMOVE_AT(fel->queue, fel->num_queue, 0);
+        if (res == 3) {
+            if (!fel->metadata_only) {
+                MP_VERBOSE(fel, "Dolby Vision MEL: the stream has no enhancement "
+                           "layer pictures. The pictures play with their RPU.\n");
+                fel->metadata_only = true;
+            }
+            return p.mpi;
+        }
+        if (res == 1) {
+            p.mpi->dovi_el = av_buffer_create((uint8_t *)el, sizeof(*el),
+                                              free_frame, NULL, 0);
+            if (!p.mpi->dovi_el) {
+                av_frame_free(&el);
+                fail(fel, "out of memory");
+            } else if (!fel->paired) {
+                MP_VERBOSE(fel, "Dolby Vision FEL: the first enhancement layer "
+                           "picture is paired.\n");
+                fel->paired = true;
+            }
+            return p.mpi;
+        }
+        if (res < 0 && !fel->failed)
+            fail(fel, "an enhancement layer picture is missing");
+        if (fel->failed)
+            return p.mpi;
+        // A picture before the first EL picture after a seek, or a picture
+        // at the end without its EL picture: CB1 shows no picture without
+        // its EL, so this one is dropped.
+        talloc_free(p.mpi);
+    }
+    return NULL;
+}
