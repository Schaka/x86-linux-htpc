new file mode 100644
index 0000000..dbdf6a9
--- /dev/null
+++ b/video/decode/cb1_fel.h
@@ -0,0 +1,63 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libavcodec/avcodec.h>
+
+struct mp_cb1_fel;
+struct mp_codec_params;
+struct mp_image;
+struct mp_log;
+
+// The number of base layer pictures that wait for their enhancement layer
+// picture. The hardware decoder needs this many extra surfaces.
+#define MP_CB1_FEL_PENDING 16
+
+// The second decoder for the enhancement layer (EL) of a Dolby Vision
+// profile 7 stream. The EL units travel inside the packets of the base
+// layer. CB1 splits them, decodes them with VA-API, and pairs each EL
+// picture with the base layer picture of the same timestamp. Each paired
+// base layer image carries its EL picture in mp_image.dovi_el.
+//
+// Returns NULL if the stream has no enhancement layer.
+struct mp_cb1_fel *mp_cb1_fel_create(struct mp_log *log,
+                                     const struct mp_codec_params *codec,
+                                     AVCodecContext *avctx);
+void mp_cb1_fel_destroy(struct mp_cb1_fel **fel);
+
+// Call when the base layer decoder is flushed, for example after a seek.
+void mp_cb1_fel_reset(struct mp_cb1_fel *fel);
+
+// Call after the base layer decoder accepted pkt. NULL marks the end of the
+// stream.
+void mp_cb1_fel_send(struct mp_cb1_fel *fel, AVCodecContext *avctx,
+                     const AVPacket *pkt);
+
+// Takes a decoded base layer picture, and the frame of the decoder that it
+// comes from. The frame gives the timestamp and the RPU of the picture.
+void mp_cb1_fel_push(struct mp_cb1_fel *fel, AVCodecContext *avctx,
+                     struct mp_image *mpi, const AVFrame *frame);
+
+// Returns the next base layer picture with its EL picture, or NULL if the
+// EL picture is not decoded yet. A MEL picture that needs no EL picture
+// comes without one. At the end of the stream (eof), pictures without an
+// EL picture are dropped.
+struct mp_image *mp_cb1_fel_pop(struct mp_cb1_fel *fel, bool eof);
