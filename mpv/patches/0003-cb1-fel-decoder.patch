         ctx->hwdec_opts->software_fallback <= 32)
@@ -1214,7 +1253,7 @@ static void send_queued_packet(struct mp_filter *vd)
 }
 
 // Returns whether decoder is still active (!EOF state).
-static int decode_frame(struct mp_filter *vd)
+static int decode_base_frame(struct mp_filter *vd)
 {
     vd_ffmpeg_ctx *ctx = vd->priv;
     AVCodecContext *avctx = ctx->avctx;
@@ -1270,12 +1309,47 @@ static int decode_frame(struct mp_filter *vd)
     mpi->dts = mp_pts_from_av(ctx->pic->pkt_dts, &ctx->codec_timebase);
     mpi->pkt_duration = mp_pts_from_av(ctx->pic->duration, &ctx->codec_timebase);
 
+#if HAVE_CB1
+    if (ctx->fel) {
+        mp_cb1_fel_push(ctx->fel, avctx, mpi, ctx->pic);
+        av_frame_unref(ctx->pic);
+        return ret;
+    }
+#endif
     av_frame_unref(ctx->pic);
 
     MP_TARRAY_APPEND(ctx, ctx->delay_queue, ctx->num_delay_queue, mpi);
     return ret;
 }
 
+static int decode_frame(struct mp_filter *vd)
+{
+#if HAVE_CB1
+    vd_ffmpeg_ctx *ctx = vd->priv;
+    // A base layer picture leaves only together with its EL picture. Until
+    // then, the base layer decoder runs on, so that the packets that follow
+    // also reach the EL decoder.
+    while (ctx->fel) {
+        struct mp_image *mpi = mp_cb1_fel_pop(ctx->fel, false);
+        if (mpi) {
+            MP_TARRAY_APPEND(ctx, ctx->delay_queue, ctx->num_delay_queue, mpi);
+            return 0;
+        }
+        int ret = decode_base_frame(vd);
+        if (ret == AVERROR_EOF && ctx->fel) {
+            mpi = mp_cb1_fel_pop(ctx->fel, true);
+            if (mpi) {
+                MP_TARRAY_APPEND(ctx, ctx->delay_queue, ctx->num_delay_queue, mpi);
+                return 0;
+            }
+        }
+        if (ret < 0)
+            return ret;
+    }
+#endif
+    return decode_base_frame(vd);
+}
+
 static int receive_frame(struct mp_filter *vd, struct mp_frame *out_frame)
 {
     vd_ffmpeg_ctx *ctx = vd->priv;
