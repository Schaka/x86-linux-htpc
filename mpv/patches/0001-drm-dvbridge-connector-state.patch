+// The HDR10 output of CB1 has 10 bits. Without DVBRIDGE_HDR10_DEEP_COLOR,
+// the kernel can choose an 8-bit link, which shows banding. With it, the
+// kernel refuses a mode that has no 10-bit link, for example on an HDMI
+// port without the bandwidth. Then the output stays HDR10 with 8 bits.
+static void set_hdr10_deep_color(struct vo_drm_state *drm, bool enable)
+{
+    struct drm_atomic_context *atomic_ctx = drm->atomic_context;
+    drm_object_set_property(atomic_ctx->request, atomic_ctx->connector,
+                            "DVBRIDGE_HDR10_DEEP_COLOR", enable);
+    if (!enable || !drmModeAtomicCommit(drm->fd, atomic_ctx->request,
+                                        DRM_MODE_ATOMIC_TEST_ONLY |
+                                        DRM_MODE_ATOMIC_ALLOW_MODESET, NULL))
+        return;
+    MP_WARN(drm, "The display link has no 10 bits for this mode. "
+            "HDR10 goes out with 8 bits.\n");
+    drm_object_set_property(atomic_ctx->request, atomic_ctx->connector,
+                            "DVBRIDGE_HDR10_DEEP_COLOR", 0);
+}
