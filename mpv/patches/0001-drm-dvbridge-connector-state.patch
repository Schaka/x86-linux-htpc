+static bool drm_object_enum_value(struct drm_object *object, const char *name,
+                                  const char *enum_name, uint64_t *value)
+{
+    for (int i = 0; i < object->props->count_props; i++) {
+        drmModePropertyRes *info = object->props_info[i];
+        if (strcmp(info->name, name))
+            continue;
+        if (!(info->flags & DRM_MODE_PROP_ENUM))
+            return false;
+        for (int j = 0; j < info->count_enums; j++) {
+            if (!strcmp(info->enums[j].name, enum_name)) {
+                *value = info->enums[j].value;
+                return true;
+            }
+        }
+        return false;
+    }
+    return false;
+}
+
+// TV-led Dolby Vision carries its metadata in the pixels of the picture.
+// The kernel sends the Dolby Vision packet while DVBRIDGE_DV_STANDARD_LAB
+// is 1, and the pixels must reach the HDMI link unchanged: 8 bits for each
+// color, full range, and no color or gamma processing on the way.
+// The HDR10 output of CB1 needs the same clean path with 10 bits. The
+// normal HDR code sets the HDR metadata, the colorspace and
+// DVBRIDGE_HDR10_DEEP_COLOR later, because the kernel accepts the last
+// one only in the same commit as the first two.
+bool drm_atomic_stage_dvbridge(struct mp_log *log, drmModeAtomicReqPtr request,
+                               struct drm_atomic_context *ctx, bool hdr10)
+{
+    const struct {
+        struct drm_object *object;
+        const char *name;
+        uint64_t value;
+        const char *enum_name;
+        bool required;
+        // The blob of the old owner can be gone at the restore. Restore no
+        // blob, because the next owner sets its own blobs anyway.
+        bool blob;
+    } settings[] = {
+        {ctx->connector, "DVBRIDGE_DV_STANDARD_LAB", !hdr10, NULL, !hdr10, false},
+        {ctx->connector, "DVBRIDGE_HDR10_DEEP_COLOR", 0, NULL, hdr10, false},
+        {ctx->connector, "HDR_OUTPUT_METADATA", 0, NULL, false, true},
+        {ctx->connector, "max bpc", hdr10 ? 10 : 8, NULL, true, false},
+        {ctx->connector, "Broadcast RGB", 0, "Full", true, false},
+        {ctx->connector, "Colorspace", 0, "Default", true, false},
+        {ctx->crtc, "CTM", 0, NULL, false, true},
+        {ctx->crtc, "GAMMA_LUT", 0, NULL, false, true},
+        {ctx->crtc, "DEGAMMA_LUT", 0, NULL, false, true},
+        {ctx->draw_plane, "rotation", DRM_MODE_ROTATE_0, NULL, false, false},
+        {ctx->draw_plane, "alpha", 0xffff, NULL, false, false},
+        {ctx->draw_plane, "pixel blend mode", 0, "None", false, false},
+        {ctx->draw_plane, "COLOR_PIPELINE", 0, NULL, false, false},
+    };
+    mp_assert(MP_ARRAY_SIZE(settings) <= DRM_ATOMIC_DVBRIDGE_MAX);
+
+    struct drm_atomic_state *old = &ctx->old_state;
+    old->num_dvbridge = 0;
+    for (int i = 0; i < MP_ARRAY_SIZE(settings); i++) {
+        uint64_t current, value = settings[i].value;
+        char *name = (char *)settings[i].name;
+        bool present = drm_object_get_property(settings[i].object, name, &current) >= 0;
+        if (present && settings[i].enum_name)
+            present = drm_object_enum_value(settings[i].object, name,
+                                            settings[i].enum_name, &value);
+        if (!present) {
+            if (settings[i].required) {
+                mp_err(log, "The DRM property \"%s\" is missing. CB1 output "
+                       "needs the patched kernel.\n", name);
+                return false;
+            }
+            continue;
+        }
+        if (drm_object_set_property(request, settings[i].object, name, value) < 0)
+            return false;
+        old->dvbridge[old->num_dvbridge++] = (struct drm_atomic_saved_value) {
+            settings[i].object, settings[i].name, settings[i].blob ? 0 : current,
+        };
+    }
+
+    // The kernel accepts TV-led Dolby Vision only while the draw plane is
+    // the single plane on the CRTC, because a second plane changes pixels.
+    // The HDR10 output keeps the same rule, so a cursor never shows.
+    // A compositor can leave its cursor plane on at a VT switch. These
+    // planes are not restored, because the compositor sets all its planes
+    // again when it gets the display back.
+    drmModePlaneRes *planes = drmModeGetPlaneResources(ctx->fd);
+    if (!planes)
+        return false;
+    bool ok = true;
+    for (uint32_t i = 0; i < planes->count_planes && ok; i++) {
+        if (planes->planes[i] == ctx->draw_plane->id)
+            continue;
+        drmModePlane *plane = drmModeGetPlane(ctx->fd, planes->planes[i]);
+        bool active = plane && plane->crtc_id == ctx->crtc->id;
+        drmModeFreePlane(plane);
+        if (!active)
+            continue;
+        struct drm_object *object = drm_object_create(log, ctx->fd, planes->planes[i],
+                                                      DRM_MODE_OBJECT_PLANE);
+        ok = object &&
+             drm_object_set_property(request, object, "FB_ID", 0) >= 0 &&
+             drm_object_set_property(request, object, "CRTC_ID", 0) >= 0;
+        if (object)
+            drm_object_free(object);
+    }
+    drmModeFreePlaneResources(planes);
+    return ok;
+}
+
+bool drm_atomic_restore_dvbridge(drmModeAtomicReqPtr request, struct drm_atomic_context *ctx)
+{
+    bool ret = true;
+    for (int i = 0; i < ctx->old_state.num_dvbridge; i++) {
+        struct drm_atomic_saved_value *saved = &ctx->old_state.dvbridge[i];
+        if (0 > drm_object_set_property(request, saved->object, (char *)saved->name, saved->value))
+            ret = false;
+    }
+    ctx->old_state.num_dvbridge = 0;
+    return ret;
+}
